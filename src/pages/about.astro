---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import paulo from '@/assets/images/paulo.jpg';
---

<BaseLayout
  pageTitle="About — Paulo Albuquerque"
  pageDescription="About Paulo Albuquerque, senior engineer based in Dublin."
>
  <article class="max-w-3xl mx-auto py-12">
    <div class="flex flex-col-reverse md:flex-row md:items-start gap-8 md:gap-12">
      <div class="flex-1">
        <h1 class="text-4xl font-bold tracking-tight mb-6">About</h1>
        <div class="prose prose-neutral dark:prose-invert max-w-none">
          <p>
            I'm Paulo, originally from Brazil, based in Dublin since 2015.
            Senior support engineer by day. Outside work, I spend most of my
            time exploring AI and building workflow automations for small
            businesses.
          </p>
          <p>
            Lately I've been deep into AI — figuring out how to use it to
            build practical workflows for small businesses, the kind that have
            real operational headaches but can't justify enterprise software.
            I enjoy the puzzle of taking something messy and manual, and
            turning it into something that mostly runs itself.
          </p>
          <p>
            My background is enterprise SaaS support: APIs, integrations,
            data flows, and the occasional 3am production fire. The skills
            transfer surprisingly well to building automations from scratch
            with tools like n8n, Claude API, and Airtable.
          </p>
          <p>
            I'm building in public. The posts here document what I learn —
            including the parts that don't work. If something I wrote helped
            you, or you're stuck on something similar, drop me a line.
          </p>
          <p>
            You can reach me at
            <a href="mailto:paulo@myneatflow.com">paulo@myneatflow.com</a>.
          </p>
        </div>
      </div>
      <div class="shrink-0">
        <Image
          src={paulo}
          alt="Paulo Albuquerque"
          width={200}
          height={267}
          class="w-48 h-64 rounded-lg object-cover"
        />
      </div>
    </div>
  </article>
</BaseLayout>
