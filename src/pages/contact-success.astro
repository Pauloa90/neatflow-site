---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  pageTitle="Got it — Paulo Albuquerque"
  pageDescription="Message received."
>
  <article class="max-w-2xl mx-auto py-20 text-center">
    <h1 class="text-4xl font-bold tracking-tight mb-4">Got it</h1>
    <p class="text-muted-foreground leading-relaxed mb-8">
      Thanks for the message. I'll reply within 1-2 days.
    </p>
    <a href="/" class="text-primary hover:underline font-medium">
      ← Back to home
    </a>
  </article>
</BaseLayout>
