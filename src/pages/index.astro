---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { defaultLanguage, useTranslations, type LanguageCode } from '@/i18n/ui';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import paulo from '@/assets/images/paulo.jpg';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
import ProjectShowcase from '@/components/ProjectShowcase.astro';

const lang =
  (Astro.currentLocale as LanguageCode | undefined) ?? defaultLanguage;
const t = useTranslations(lang, 'homePage');

const allPosts: Array<CollectionEntry<'blog'>> = await getCollection(
  'blog',
  ({ data, id }) => data.isDraft !== true && id.startsWith('en/')
);

const enriched = await Promise.all(
  allPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      id: post.id,
      slug: post.id.replace(/^en\//, '').replace(/\.(md|mdx)$/, ''),
      data: { ...post.data, readingTimeMinutes: remarkPluginFrontmatter.readingTimeMinutes },
    };
  })
);

enriched.sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const recent = enriched.slice(0, 5);
---

<BaseLayout pageTitle={t('pageTitle')} pageDescription={t('pageDescription')}>
  <!-- 1. Eu: a foto limpa e a apresentação -->
  <section class="relative max-w-5xl mx-auto pt-8 md:pt-16 pb-20" data-hero data-home>
    <canvas data-field aria-hidden="true" class="pointer-events-none absolute top-[-6rem] bottom-0 left-1/2 -z-10 w-screen -translate-x-1/2"></canvas>
    <div class="flex flex-col-reverse md:flex-row md:items-center gap-10 md:gap-16">
      <div class="flex-1 min-w-0">
        <p class="mono mb-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
          <span class="inline-flex items-center gap-2 text-primary"><span class="live-dot"></span>online</span>
          <span class="opacity-40">/</span><span>Dublin, IE</span>
          <span class="opacity-40">/</span><span data-clock>--:--:--</span>
        </p>
        <h1 class="text-6xl md:text-[5.4rem] leading-[1.02] tracking-tight mb-6 select-none" style="font-family:'Inter',system-ui,sans-serif" aria-label="Hi, I'm Paulo" data-kinetic>
          {[...`Hi, I'm Paulo`].map((c) => (c === ' '
            ? <span aria-hidden="true" class="inline-block w-[0.28em]"></span>
            : <span aria-hidden="true" class="kc inline-block" data-ch={c} style="font-variation-settings:'wght' 640">{c}</span>))}
        </h1>
        <p class="mono mb-6 text-base md:text-lg text-foreground">
          <span class="text-primary">&gt;</span> building <span class="text-primary" data-roles>automation</span><span class="caret"></span>
        </p>
        <p class="text-lg text-muted-foreground leading-relaxed mb-4 max-w-[52ch]">
          I'm an engineer in Dublin who likes playing with automation. The fun part
          is figuring out which pieces actually help people: in small businesses,
          side projects and the small frictions of everyday life.
        </p>
        <p class="text-lg text-muted-foreground leading-relaxed max-w-[52ch]">
          Below is what I'm building right now. I write down what I learn.
        </p>
        <div class="mono mt-9 flex flex-wrap items-center gap-3 text-sm">
          <a href="#building" class="btn-tech btn-tech--solid">./what-im-building</a>
          <a href="#videos" class="btn-tech">./videos</a>
          <a href="#recent-posts" class="btn-tech">./writing</a>
        </div>
      </div>
      <div class="shrink-0 mx-auto md:mx-0">
        <figure class="hud relative w-60 md:w-72">
          <Image
            src={paulo}
            alt="Paulo Albuquerque"
            width={420}
            height={560}
            class="relative w-60 h-80 md:w-72 md:h-96 object-cover object-top grayscale-[35%] contrast-[1.05]"
          />
          <span class="hud-scan" aria-hidden="true"></span>
          <span class="hud-c tl"></span><span class="hud-c tr"></span><span class="hud-c bl"></span><span class="hud-c br"></span>
          <figcaption class="mono mt-3 flex justify-between text-[10px] uppercase tracking-[0.2em] text-muted-foreground">
            <span>paulo.albuquerque</span><span class="text-primary">engineer</span>
          </figcaption>
        </figure>
      </div>
    </div>
    <dl class="mono mt-14 grid grid-cols-3 border-y border-border text-center md:text-left">
      <div class="py-4 md:pl-1"><dt class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground">projects</dt><dd class="mt-1 text-2xl text-foreground" data-count="5">0</dd></div>
      <div class="py-4 border-x border-border md:pl-5"><dt class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground">videos</dt><dd class="mt-1 text-2xl text-foreground" data-count="3">0</dd></div>
      <div class="py-4 md:pl-5"><dt class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground">posts</dt><dd class="mt-1 text-2xl text-foreground" data-count={enriched.length}>0</dd></div>
    </dl>
  </section>

  <!-- 2. Projetos, com demonstração animada -->
  <section id="building" class="max-w-5xl mx-auto py-14 scroll-mt-24">
    <p class="mono mb-3 text-xs uppercase tracking-[0.25em] text-primary">01 / build log</p>
    <h2 class="text-3xl md:text-4xl font-bold mb-3">What I'm building</h2>
    <p class="text-muted-foreground mb-10 max-w-[56ch]">Small projects I use myself. Pick one to see what it is and how it helps me.</p>
    <ProjectShowcase />
  </section>

  <!-- 3. Vídeos: logo depois dos projetos -->
  <section id="videos" class="max-w-5xl mx-auto py-14 scroll-mt-24 border-t border-border">
    <p class="mono mb-3 text-xs uppercase tracking-[0.25em] text-primary">02 / transmissions</p>
    <div class="flex items-baseline justify-between gap-6 mb-8">
      <h2 class="text-3xl md:text-4xl font-bold">Watch</h2>
      <a
        href="https://www.youtube.com/@Paulo-MyNeatFlow"
        target="_blank"
        rel="noopener"
        class="text-primary hover:underline font-medium"
      >
        More on YouTube →
      </a>
    </div>
    <div class="mb-8">
      <p class="mono mb-3 text-[11px] uppercase tracking-[0.22em] text-primary"><span class="live-dot inline-block mr-2 align-middle"></span>latest upload</p>
      <YouTubeEmbed id="rSj6xmVPQtg" title="RAG vs Fine-Tuning: Which One Does Your AI Actually Need?" />
    </div>
    <div class="grid gap-8 sm:grid-cols-2">
      <YouTubeEmbed id="h-i18kry7G4" title="3 Ways I Use Claude That Actually Work" />
      <YouTubeEmbed id="aGtqqZhxFz0" title="AI Turned My ADHD Into a Superpower (2026)" />
    </div>
  </section>

  <!-- 4. Escritos -->
  <section id="recent-posts" class="max-w-5xl mx-auto py-14 scroll-mt-24 border-t border-border">
    <p class="mono mb-3 text-xs uppercase tracking-[0.25em] text-primary">03 / logs</p>
    <h2 class="text-3xl md:text-4xl font-bold mb-8">{t('recentPostsTitle')}</h2>
    <ul class="space-y-2">
      {
        recent.map((post) => (
          <li class="border-b border-border last:border-b-0">
            <a href={`/blog/${post.slug}`} class="group grid md:grid-cols-[10rem_1fr] gap-x-8 gap-y-1 py-6">
              <time class="text-sm text-muted-foreground md:pt-1.5" datetime={new Date(post.data.pubDate).toISOString()}>
                {new Date(post.data.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <div>
                <h3 class="text-xl md:text-2xl font-medium leading-snug group-hover:text-primary transition-colors">{post.data.title}</h3>
                {post.data.description && (
                  <p class="text-muted-foreground mt-2 text-sm leading-relaxed max-w-[62ch]">{post.data.description}</p>
                )}
                {post.data.readingTimeMinutes && (
                  <span class="text-xs text-muted-foreground mt-2 inline-block">{post.data.readingTimeMinutes} min read</span>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <a href="/blog" class="text-primary hover:underline font-medium">
        {t('seeAllPosts')} →
      </a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Tema "tech" só na home: escuro, acento menta elétrico */
  html:has([data-home]), html.dark:has([data-home]) {
    --background: oklch(0.145 0.012 255);
    --foreground: oklch(0.96 0.005 255);
    --card: oklch(0.18 0.014 255);
    --card-foreground: oklch(0.96 0.005 255);
    --popover: oklch(0.18 0.014 255);
    --popover-foreground: oklch(0.96 0.005 255);
    --primary: oklch(0.86 0.17 165);
    --primary-foreground: oklch(0.16 0.02 255);
    --muted: oklch(0.22 0.015 255);
    --muted-foreground: oklch(0.7 0.02 255);
    --accent: oklch(0.24 0.02 255);
    --accent-foreground: oklch(0.96 0.005 255);
    --border: oklch(1 0 0 / 0.1);
    --input: oklch(1 0 0 / 0.12);
    --ring: oklch(0.86 0.17 165);
    color-scheme: dark;
    overflow-x: clip;
  }
  html:has([data-home]) body { background: var(--background); }
  html:has([data-home]) ::selection { background: var(--primary); color: var(--primary-foreground); }
  .mono, #recent-posts time { font-family: 'JetBrains Mono', ui-monospace, monospace; }

  .live-dot { width: 7px; height: 7px; border-radius: 99px; background: var(--primary); animation: livePulse 2s infinite; }
  @keyframes livePulse { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--primary) 60%, transparent); } 70%, 100% { box-shadow: 0 0 0 8px transparent; } }
  .caret { display: inline-block; width: .55em; height: 1.05em; margin-left: 3px; vertical-align: -0.15em; background: var(--primary); animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }

  [data-kinetic] .kc.is-scr { color: var(--primary); }

  .btn-tech { display: inline-flex; align-items: center; padding: .55rem 1rem; border: 1px solid var(--border); border-radius: 6px; color: var(--muted-foreground); transition: color .2s, border-color .2s, background .2s, box-shadow .2s; }
  .btn-tech:hover { color: var(--foreground); border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary), 0 0 24px -6px var(--primary); }
  .btn-tech--solid { background: var(--primary); color: var(--primary-foreground); border-color: var(--primary); font-weight: 600; }
  .btn-tech--solid:hover { color: var(--primary-foreground); background: color-mix(in oklab, var(--primary) 85%, white); }

  .hud { --h: 20rem; }
  @media (min-width: 768px) { .hud { --h: 24rem; } }
  .hud img { border-radius: 2px; }
  .hud::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: var(--h); pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0,0,0,.16) 0 1px, transparent 1px 3px), linear-gradient(180deg, transparent 60%, color-mix(in oklab, var(--background) 65%, transparent)); }
  .hud-scan { position: absolute; left: 0; right: 0; top: 0; height: 2px; z-index: 2; background: var(--primary); box-shadow: 0 0 14px 2px var(--primary); opacity: 0; animation: scan 4.5s cubic-bezier(.6,0,.4,1) infinite; pointer-events: none; }
  @keyframes scan { 0% { transform: translateY(0); opacity: 0; } 10% { opacity: .7; } 85% { opacity: .7; } 100% { transform: translateY(calc(var(--h) - 2px)); opacity: 0; } }
  .hud-c { position: absolute; width: 16px; height: 16px; border: 0 solid var(--primary); z-index: 2; pointer-events: none; }
  .hud-c.tl { top: -8px; left: -8px; border-top-width: 2px; border-left-width: 2px; }
  .hud-c.tr { top: -8px; right: -8px; border-top-width: 2px; border-right-width: 2px; }
  .hud-c.bl { top: calc(var(--h) - 8px); left: -8px; border-bottom-width: 2px; border-left-width: 2px; }
  .hud-c.br { top: calc(var(--h) - 8px); right: -8px; border-bottom-width: 2px; border-right-width: 2px; }

  [data-showcase] .pj-stage { box-shadow: 0 0 0 1px var(--border), 0 30px 80px -30px color-mix(in oklab, var(--primary) 35%, transparent); }

  /* Cursor: ponto pequeno + anel fino que só cresce um pouco em links */
  .fx-dot, .fx-ring, .fx-tag { position: fixed; left: 0; top: 0; z-index: 9999; pointer-events: none; will-change: transform; }
  .fx-dot { width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 99px; background: var(--primary); }
  .fx-ring { width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 99px; border: 1px solid color-mix(in oklab, var(--primary) 60%, transparent); transition: width .2s, height .2s, margin .2s, border-color .2s; }
  .fx-ring.is-link { width: 28px; height: 28px; margin: -14px 0 0 -14px; border-color: var(--primary); }
  .fx-tag { margin: 14px 0 0 14px; padding: 2px 6px; border-radius: 3px; background: var(--primary); color: var(--primary-foreground); font: 600 10px/1.3 'JetBrains Mono', monospace; letter-spacing: .08em; text-transform: uppercase; opacity: 0; transition: opacity .15s; }
  .fx-tag.on { opacity: 1; }
  .fx-on, .fx-on a, .fx-on button, .fx-on summary, .fx-on [data-cursor] { cursor: none !important; }
  @media (pointer: coarse), (prefers-reduced-motion: reduce) { .fx-dot, .fx-ring, .fx-tag { display: none; } }
</style>

<script>
  let off: (() => void) | undefined;
  function boot() {
    off?.();
    const fine = matchMedia('(pointer: fine)').matches, reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const title = hero.querySelector<HTMLElement>('[data-kinetic]');
    const cleanups: Array<() => void> = [];
    const on = <K extends keyof DocumentEventMap>(t: Document, ev: K, fn: (e: DocumentEventMap[K]) => void) => { t.addEventListener(ev, fn); cleanups.push(() => t.removeEventListener(ev, fn)); };
    let mx = -9999, my = -9999, moved = false;
    const GLYPHS = '01<>/{}[]#$%&*+=?ABCDEFXYZ';

    // 1. Título: descodifica letra a letra ao carregar; depois o peso segue o cursor
    if (title) {
      const chars = [...title.querySelectorAll<HTMLElement>('.kc')];
      const w = chars.map(() => 640);
      const t0 = performance.now();
      let raf = 0;
      const loop = (now: number) => {
        const t = (now - t0) / 1000;
        chars.forEach((c, i) => {
          const lock = 0.25 + i * 0.07;
          if (!reduce && t < lock) { c.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0]; c.classList.add('is-scr'); }
          else if (c.classList.contains('is-scr')) { c.textContent = c.dataset.ch!; c.classList.remove('is-scr'); }
          let target = 700;
          if (!reduce && fine && moved) {
            const r = c.getBoundingClientRect(), d = Math.hypot(mx - (r.left + r.width / 2), my - (r.top + r.height / 2));
            target = 520 + 380 * Math.exp(-Math.pow(d / 160, 2));
          }
          w[i] += (target - w[i]) * 0.14;
          c.style.fontVariationSettings = `'wght' ${w[i].toFixed(0)}`;
        });
        raf = requestAnimationFrame(loop);
      };
      raf = requestAnimationFrame(loop);
      cleanups.push(() => cancelAnimationFrame(raf));
    }

    // 2. Papéis a escrever-se sozinhos
    const roles = hero.querySelector<HTMLElement>('[data-roles]');
    if (roles && !reduce) {
      const list = ['automation', 'local AI', 'tools for ADHD brains', 'a video editor that edits me', 'my own dashboard'];
      let k = 0, n = list[0].length, dir = -1, hold = 40, tm = 0;
      const step = () => {
        if (hold > 0) hold--;
        else { n += dir; if (n <= 0) { dir = 1; k = (k + 1) % list.length; } if (n >= list[k].length && dir > 0) { dir = -1; hold = 45; } }
        roles.textContent = list[k].slice(0, Math.max(0, n));
        tm = window.setTimeout(step, dir > 0 ? 55 : 28);
      };
      tm = window.setTimeout(step, 1600);
      cleanups.push(() => clearTimeout(tm));
    }

    // 3. Relógio de Dublin e contadores
    const clock = hero.querySelector<HTMLElement>('[data-clock]');
    if (clock) {
      const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Dublin', hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const tick = () => (clock.textContent = fmt.format(new Date()));
      tick(); const iv = setInterval(tick, 1000); cleanups.push(() => clearInterval(iv));
    }
    hero.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const to = Number(el.dataset.count), t0 = performance.now();
      if (reduce) { el.textContent = String(to).padStart(2, '0'); return; }
      const f = (now: number) => { const p = Math.min(1, (now - t0) / 1200); el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3)))).padStart(2, '0'); if (p < 1) requestAnimationFrame(f); };
      requestAnimationFrame(f);
    });

    // 4. Campo de pontos atrás da hero: acendem e afastam-se do cursor, com uma varredura lenta
    const cv = hero.querySelector<HTMLCanvasElement>('[data-field]');
    if (cv) {
      const ctx = cv.getContext('2d')!;
      const probe = document.createElement('span'); probe.style.color = 'var(--primary)'; document.body.append(probe);
      const accent = getComputedStyle(probe).color; probe.remove();
      let W = 0, H = 0, raf = 0;
      let pts: Array<{ x: number; y: number; ox: number; oy: number }> = [];
      const GAP = 30;
      const size = () => {
        const dpr = Math.min(2, devicePixelRatio || 1), r = cv.getBoundingClientRect(); W = r.width; H = r.height;
        cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        pts = []; for (let y = GAP / 2; y < H; y += GAP) for (let x = (W % GAP) / 2; x < W; x += GAP) pts.push({ x, y, ox: x, oy: y });
      };
      size(); const ro = new ResizeObserver(size); ro.observe(cv); cleanups.push(() => ro.disconnect());
      const t0 = performance.now();
      const draw = (now: number) => {
        const r = cv.getBoundingClientRect(), lx = mx - r.left, ly = my - r.top, t = (now - t0) / 1000;
        const sweep = ((t * 0.12) % 1.4 - 0.2) * W;
        ctx.clearRect(0, 0, W, H);
        for (const p of pts) {
          const dx = p.ox - lx, dy = p.oy - ly, d = Math.hypot(dx, dy), f = reduce ? 0 : Math.exp(-(d * d) / (2 * 120 * 120));
          const tx = p.ox + (d ? (dx / d) * f * 14 : 0), ty = p.oy + (d ? (dy / d) * f * 14 : 0);
          p.x += (tx - p.x) * 0.15; p.y += (ty - p.y) * 0.15;
          const s = reduce ? 0 : Math.exp(-Math.pow((p.ox - sweep) / 60, 2)) * 0.5;
          const fadeY = Math.max(0, Math.min(1, (H - p.oy) / (H * 0.35)));
          ctx.globalAlpha = (0.13 + f * 0.85 + s * 0.4) * fadeY;
          ctx.fillStyle = f > 0.08 || s > 0.1 ? accent : '#9aa6c0';
          const rad = 1 + f * 1.4;
          ctx.fillRect(p.x - rad / 2, p.y - rad / 2, rad, rad);
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(draw);
      };
      raf = requestAnimationFrame(draw); cleanups.push(() => cancelAnimationFrame(raf));
    }

    // 5. Cursor pequeno: ponto + anel fino; etiqueta mono ao lado quando há ação
    if (fine && !reduce) {
      const mk = (c: string) => Object.assign(document.createElement('div'), { className: c });
      const dot = mk('fx-dot'), ring = mk('fx-ring'), tag = mk('fx-tag');
      document.body.append(dot, ring, tag); document.documentElement.classList.add('fx-on');
      let rx = -100, ry = -100, raf2 = 0;
      const loop = () => { rx += (mx - rx) * 0.3; ry += (my - ry) * 0.3; ring.style.transform = `translate(${rx}px,${ry}px)`; raf2 = requestAnimationFrame(loop); };
      raf2 = requestAnimationFrame(loop);
      on(document, 'pointermove', (e) => {
        mx = e.clientX; my = e.clientY; moved = true;
        dot.style.transform = `translate(${mx}px,${my}px)`; tag.style.transform = `translate(${mx}px,${my}px)`;
        const el = (e.target instanceof Element ? e.target : null)?.closest<HTMLElement>('[data-cursor], a, button, summary, [role=tab]');
        const label = el?.dataset.cursor;
        ring.classList.toggle('is-link', !!el); tag.classList.toggle('on', !!label); if (label) tag.textContent = label;
      });
      cleanups.push(() => { cancelAnimationFrame(raf2); dot.remove(); ring.remove(); tag.remove(); document.documentElement.classList.remove('fx-on'); });
    } else on(document, 'pointermove', (e) => { mx = e.clientX; my = e.clientY; moved = true; });

    off = () => { cleanups.splice(0).forEach((f) => f()); };
  }
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => off?.());
</script>
