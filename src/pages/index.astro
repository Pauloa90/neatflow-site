---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { defaultLanguage, useTranslations, type LanguageCode } from '@/i18n/ui';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import paulo from '@/assets/images/paulo.jpg';

const lang =
  (Astro.currentLocale as LanguageCode | undefined) ?? defaultLanguage;
const t = useTranslations(lang, 'homePage');

const allPosts: Array<CollectionEntry<'blog'>> = await getCollection(
  'blog',
  ({ data, id }) => data.isDraft !== true && id.startsWith('en/')
);

const enriched = await Promise.all(
  allPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      id: post.id,
      slug: post.id.replace(/^en\//, '').replace(/\.(md|mdx)$/, ''),
      data: { ...post.data, readingTimeMinutes: remarkPluginFrontmatter.readingTimeMinutes },
    };
  })
);

enriched.sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const recent = enriched.slice(0, 5);
---

<BaseLayout pageTitle={t('pageTitle')} pageDescription={t('pageDescription')}>
  <section class="max-w-3xl mx-auto py-12">
    <div class="flex flex-col-reverse md:flex-row md:items-center gap-8 md:gap-12">
      <div class="flex-1">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">
          Hi, I'm Paulo
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed mb-4">
          I'm a senior support engineer in Dublin who spent the last decade
          fixing systems for companies you've heard of. Now I'm building
          automations on the side for the small businesses you haven't.
        </p>
        <p class="text-lg text-muted-foreground leading-relaxed">
          I write here about what I learn while doing it — what works, what
          wastes time, and what most "AI for business" advice gets wrong. New
          post every week or two.
        </p>
        <a href="#recent-posts" class="text-sm underline mt-4 inline-block">
          Read latest ↓
        </a>
      </div>
      <div class="shrink-0">
        <Image
          src={paulo}
          alt="Paulo Albuquerque"
          width={240}
          height={320}
          class="w-60 h-80 rounded-lg object-cover"
        />
      </div>
    </div>
  </section>

  <section id="recent-posts" class="max-w-3xl mx-auto py-8 scroll-mt-20">
    <h2 class="text-2xl font-semibold mb-6">{t('recentPostsTitle')}</h2>
    <ul class="space-y-6">
      {
        recent.map((post) => (
          <li class="border-b pb-6 last:border-b-0">
            <a href={`/blog/${post.slug}`} class="block group">
              <h3 class="text-xl font-medium group-hover:text-primary transition-colors">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  {post.data.description}
                </p>
              )}
              <div class="flex gap-4 mt-2 text-xs text-muted-foreground">
                <time datetime={new Date(post.data.pubDate).toISOString()}>
                  {new Date(post.data.pubDate).toLocaleDateString('en-GB', {
                    day: 'numeric', month: 'short', year: 'numeric',
                  })}
                </time>
                {post.data.readingTimeMinutes && (
                  <span>{post.data.readingTimeMinutes} min read</span>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <a href="/blog" class="text-primary hover:underline font-medium">
        {t('seeAllPosts')} →
      </a>
    </div>
  </section>
</BaseLayout>
